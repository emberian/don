}

int scenario research_only(int who, ref int step, int boom_vs_rush, int num_loops)
{
    step = research_tech_with_cost(who, "Written Word");
    return step;
}

int scenario difficulty_refusals(int who, ref int step, int boom_vs_rush, int num_loops)
{
    step = set_difficulty(0);
    step += set_difficulty(7);
    step += set_leader_difficulty(who, 0);
    step += set_leader_difficulty(0, 6);
    step += get_leader_difficulty(0);
    return step;
}

int scenario place_prefix_only(int who, ref int step, int boom_vs_rush, int num_loops)
{
    step = place_building_with_cost(who, "Farm", "Athens");
    return step;
}
