{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://don.invalid/schema/retail-control-incident-closure-v1.json",
  "title": "DoN retail controller STOP incident closure proof",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "recorded_on", "original_incident", "later_active_lifecycle", "closure"],
  "properties": {
    "schema": {"const": "don.retail-control.incident-closure.v1"},
    "recorded_on": {"const": "2026-08-09"},
    "original_incident": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "controller_generation", "pid", "dump_retained", "causality_status"],
      "properties": {
        "path": {"const": "schema/live/retail-control-stop-incident-v1.json"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "controller_generation": {"const": "tactical-v19"},
        "pid": {"const": 12324},
        "dump_retained": {"const": false},
        "causality_status": {"const": "unresolved-no-retained-stack"}
      }
    },
    "later_active_lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "controller_generation", "controller_dll_sha256", "process_scope"],
      "properties": {
        "path": {"const": "schema/live/retail-control-active-stop-cycles-v1.json"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "controller_generation": {"const": "relaunch-v22"},
        "controller_dll_sha256": {"const": "e2829ae2ae93e24e95b87d2d9e469fc79e915b67e30f53d9638b84fbe6c92527"},
        "process_scope": {"const": "freshly paused solo skirmish"}
      }
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_main_thread_boundary_exercised", "consecutive_stop_rearm_cycles", "final_park_acknowledged", "dropped_events_after_each_acknowledgement", "exact_original_bytes_restored_after_every_stop", "scoped_wer_dump_directory_new_files", "candidate_bound_reversibility_soak", "original_incident_causality_remains_unresolved"],
      "properties": {
        "active_main_thread_boundary_exercised": {"const": true},
        "consecutive_stop_rearm_cycles": {"const": 5},
        "final_park_acknowledged": {"const": true},
        "dropped_events_after_each_acknowledgement": {"const": 0},
        "exact_original_bytes_restored_after_every_stop": {"const": true},
        "scoped_wer_dump_directory_new_files": {"const": 0},
        "candidate_bound_reversibility_soak": {"const": true},
        "original_incident_causality_remains_unresolved": {"const": true}
      }
    }
  }
}
