{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://descentofnations.invalid/schemas/release-component-provenance-v1.json",
  "title": "Descent of Nations release component provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "component", "payload", "lock", "selection", "claims"],
  "properties": {
    "schema": {"const": "don.release-component-provenance.v1"},
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "payload": {"$ref": "#/$defs/file"},
    "lock": {"$ref": "#/$defs/file"},
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_package", "method", "packages"],
      "properties": {
        "root_package": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "packages": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/package"}
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_bytes_hash_bound",
        "lock_graph_hash_bound",
        "registry_archive_checksums_verified",
        "license_declarations_mechanically_captured",
        "binary_dependency_reachability_proven",
        "notice_sufficiency_reviewed",
        "source_provision_reviewed",
        "whole_product_payload"
      ],
      "properties": {
        "component_bytes_hash_bound": {"const": true},
        "lock_graph_hash_bound": {"const": true},
        "registry_archive_checksums_verified": {"const": true},
        "license_declarations_mechanically_captured": {"const": true},
        "binary_dependency_reachability_proven": {"const": false},
        "notice_sufficiency_reviewed": {"const": false},
        "source_provision_reviewed": {"const": false},
        "whole_product_payload": {"const": false}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "size": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "source", "checksum"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "source": {"type": ["string", "null"]},
        "checksum": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "origin", "archive", "license"],
      "properties": {
        "identity": {"$ref": "#/$defs/identity"},
        "origin": {"enum": ["repository-path", "crates.io-registry"]},
        "archive": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "sha256"],
              "properties": {
                "url": {"type": "string", "minLength": 1},
                "sha256": {"$ref": "#/$defs/digest"}
              }
            }
          ]
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["declared_expression", "declaration_evidence", "bundled_texts", "review_state"],
          "properties": {
            "declared_expression": {"type": "string", "minLength": 1},
            "declaration_evidence": {
              "anyOf": [
                {"$ref": "#/$defs/file"},
                {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}}
              ]
            },
            "bundled_texts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
            "review_state": {"const": "pending-human-obligation-review"}
          }
        }
      }
    }
  }
}
